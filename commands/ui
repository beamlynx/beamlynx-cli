#!/usr/bin/env bash
. "$WORKDIR/common"

cd $WORKDIR

echo "This always opens in a regular browser tab -- 'desktop' here only"
echo "simulates the desktop app's runtime behavior (e.g. hidden version chip,"
echo "desktop keybindings), it does not launch Electron. Use 'beam desktop'"
echo "for that."
read -p "Simulate desktop app behavior? [y/N] " mode
case "$mode" in
  y|Y)
    echo "Simulating desktop app behavior (NEXT_PUBLIC_DESKTOP=1)"
    export NEXT_PUBLIC_DESKTOP=1
    ;;
  *)
    echo "Running as regular browser behavior"
    ;;
esac

eval dir="$UI_PATH"
cd "$dir"

./run.sh
