#!/usr/bin/env bash
. "$WORKDIR/common"

cd $WORKDIR

if [ "$1" = "--desktop" ]; then
  echo "Simulating desktop app behavior (NEXT_PUBLIC_DESKTOP=1): hidden version chip,"
  echo "desktop keybindings. This does not launch Electron -- use 'beam desktop' for that."
  export NEXT_PUBLIC_DESKTOP=1
else
  echo "Running as regular browser behavior (beamlynx.com website mode)."
  echo "Use 'beam ui --desktop' to simulate desktop app behavior instead."
fi

eval dir="$UI_PATH"
cd "$dir"

./run.sh
